            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jane Doe\",\n  \"product\": \"27-inch Monitor\",\n  \"quantity\": 2,\n  \"unitPrice\": 249.99\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set(\"orderId\", id);",
                  "pm.test(\"Location header set\", () => pm.response.to.have.header(\"Location\"));"
